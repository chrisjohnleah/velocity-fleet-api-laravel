includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - src
    tmpDir: build/phpstan
    treatPhpDocTypesAsCertain: false
    excludePaths:
        # Consumer-facing test scaffolding — exercised by host-app test suites,
        # not by the library core, so it reads as "unused" to static analysis.
        - src/Testing/InteractsWithVelocityFleet.php
